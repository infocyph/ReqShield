{
    "name": "infocyph/reqshield",
    "description": "Fast, modern PHP request validation and sanitization. Schema-based rules, fail-fast execution, typed input, PSR-7 friendly.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "validation",
        "validator",
        "request",
        "input",
        "sanitization",
        "schema",
        "rules",
        "psr-7",
        "http",
        "security"
    ],
    "authors": [
        {
            "name": "Infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-fileinfo": "*",
        "ext-hash": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "infocyph/dblayer": "^6.1.3",
        "infocyph/phpforge": "dev-main@dev",
        "infocyph/runwire": "^3.0"
    },
    "conflict": {
        "infocyph/dblayer": "<6.0"
    },
    "suggest": {
        "infocyph/dblayer": "Optional DBLayer 6 exists/unique provider, including host-owned Runwire forwarding.",
        "infocyph/runwire": "Optional Runwire 3.0 host-owned cancellation/deadline and coroutine integration via validateWithRunwire()."
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\ReqShield\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Infocyph\\ReqShield\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/.automation",
            "/.aws",
            "/.build",
            "/.codex",
            "/.idea",
            "/.phpunit.cache",
            "/.psalm-cache",
            "/.tmp",
            "/.vscode",
            "/build",
            "/composer.lock",
            "/coverage",
            "/dist",
            "/graphify-out",
            "/node_modules",
            "/phpforge",
            "/plans",
            "/tmp",
            "/var",
            "/vendor"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "benchmark:representative": "@composer ic:benchmark"
    }
}
